# Local benchmark choices.
# Copy this file to .env and set values that deliberately differ from native defaults.
#
# Hashmarks is developed locally, so the benchmark must choose the exact clean
# committed checkout under test rather than whichever hashmarks happens to be on PATH.
HASHMARKS_BENCH_SOURCE=/absolute/path/to/Hashmarks
#
# Codex, OpenCode, and Enola use their normal native Linux installation/config
# discovery. Their resolved executable/config identity is observed and bound into
# benchmark evidence; do not duplicate normal ~/.local/bin, ~/.codex, HOME, or
# ~/.config paths here.
#
# Select one or both native agents for preflight, execution, and scoring.
# Examples: opencode-native or codex-native,opencode-native.
# Readiness checks both agents regardless of this value. No agent is defaulted.
BENCHMARK_AGENT=
#
# OpenCode agent persona is a benchmark choice when OpenCode is selected.
BENCHMARK_OPENCODE_AGENT=build
#
# Optional provider environment:
# Participant processes do not inherit arbitrary host variables. If a native
# provider requires environment credentials, list those variable names explicitly.
BENCHMARK_PASSTHROUGH_ENV_KEYS=
#
# Benchmark definition:
# Repository-relative path to the committed suite definition.
# make benchmark-check needs this plus subject runtime choices above; it does not
# need BENCHMARK_AGENT, campaign/output, or harness paths.
BENCHMARK_SUITE_PATH=benchmarks/suites/repository-intelligence/heldout-v1
#
# Campaign runtime/evidence (benchmark-check-all / benchmark / reporting):
# Durable local store of numbered runs. The directory is ignored by Git.
BENCHMARK_CAMPAIGN_ROOT=.benchmark-runs/heldout-v1
#
# Harness source:
# Path to the EvalShot checkout that owns the benchmark runner code.
BENCHMARK_HARNESS_REPO_ROOT=.
#
# Optional suite-specific scorer accepting --results, --output, --agent, and
# repeated --definition-id values from frozen campaign authority:
BENCHMARK_SCORE_SCRIPT_PATH=benchmarks/suites/repository-intelligence/heldout-v1/score.py
# Filename written under the selected saved run's reports/ directory.
# status.json and report.json are written there by their commands as well.
BENCHMARK_SCORE_OUTPUT_PATH=score.json

# Optional Harbor cross-harness projection.
# Harbor remains execution infrastructure; EvalShot owns the frozen task
# and comparison contract. One model is required across selected harnesses so a
# run does not silently turn into a model comparison.
BENCHMARK_HARBOR_MODEL=
BENCHMARK_HARBOR_EXECUTABLE=harbor
# Provider variable names use the shared BENCHMARK_PASSTHROUGH_ENV_KEYS above.
# Their values stay in the host environment and are copied to a run-local
# mode-0600 Harbor env file.

# Optional multidomain-v2 campaign: explicitly replace the suite, campaign,
# scorer, and output paths above with the values in its README before running it.
# This draft benchmark is never part of a Hashmarks release.

# Optional OpenAI Responses routing dogfood.
# These are non-secret benchmark choices. The two API keys are deliberately NOT
# read from this file; export OPENAI_API_KEY and CONTROL_PLANE_API_KEY in the
# shell that starts the run.
#
# Required once before "make benchmark-openai-routing":
OPENAI_ROUTING_TUNNEL_ID=
OPENAI_ROUTING_MODEL=
#
# Optional overrides. Empty values use repository/native defaults:
# - workspace: current EvalShot checkout
# - handoff: ../Hashmarks/dist/chatgpt-secure-mcp-tunnel-handoff.json
# - tunnel client: resolve tunnel-client from PATH
# - manifest: checked-in three-way nine-task dogfood v3
# - repeats: 1
# - run root: .benchmark-runs/openai-routing
OPENAI_ROUTING_WORKSPACE=
OPENAI_ROUTING_HANDOFF=
OPENAI_ROUTING_TUNNEL_CLIENT=
OPENAI_ROUTING_MANIFEST=
OPENAI_ROUTING_REPEATS=
OPENAI_ROUTING_RUN_ROOT=
