{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "repository",
    "prompt",
    "mode",
    "mutation",
    "oracle",
    "budgets",
    "contamination"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit",
        "tree"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "mutation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "artifact",
            "sha256",
            "changed_paths"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "changed_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "sha256", "target"],
        "properties": {
          "artifact": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "identity",
        "configuration"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mode": {
      "enum": [
        "read_only",
        "edit"
      ]
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_change_globs",
        "allowed_generated_globs"
      ],
      "properties": {
        "allowed_change_globs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_generated_globs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
