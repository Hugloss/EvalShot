# Copy to .env.headroom and set the exact clean Hashmarks checkout under test.
HASHMARKS_BENCH_SOURCE=/absolute/path/to/Hashmarks

# Select one or both native agents.
BENCHMARK_AGENT=opencode-native

BENCHMARK_OPENCODE_AGENT=build
BENCHMARK_PASSTHROUGH_ENV_KEYS=

BENCHMARK_SUITE_PATH=benchmarks/suites/repository-intelligence/headroom-v2
BENCHMARK_CAMPAIGN_ROOT=.benchmark-runs/headroom-v2
BENCHMARK_HARNESS_REPO_ROOT=.
BENCHMARK_SCORE_SCRIPT_PATH=benchmarks/suites/repository-intelligence/headroom-v2/score.py
BENCHMARK_SCORE_OUTPUT_PATH=score.json
