{
  "id": "locate-stale-index-removal",
  "version": 2,
  "family": "python-localization",
  "mode": "read_only",
  "repository": {
    "url": "https://github.com/Hugloss/Hashmarks.git",
    "commit": "85453be578e8ff46b8d79b363f140a915d6804f6",
    "tree": "667b7066be9ef6cab6e1ce3a28a603481f07387e"
  },
  "prompt": "Without editing files, identify the function that removes stale indexed paths during a full CodeMap sync. Return exactly one JSON object with keys path and symbol, and nothing else.",
  "mutation": null,
  "oracle": {
    "adapter": "repository-location-json",
    "identity": {
      "id": "locate-stale-index-removal-oracle",
