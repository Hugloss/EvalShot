# Copy to .env.context-invariance and set the exact clean Hashmarks checkout.
HASHMARKS_BENCH_SOURCE=/absolute/path/to/Hashmarks

# Select one or both native agents.
# Cross-agent observations remain descriptive; each context comparison is within one agent.
BENCHMARK_AGENT=opencode-native

BENCHMARK_OPENCODE_AGENT=build
BENCHMARK_PASSTHROUGH_ENV_KEYS=

BENCHMARK_SUITE_PATH=benchmarks/suites/repository-intelligence/context-invariance-v1
BENCHMARK_CAMPAIGN_ROOT=.benchmark-runs/context-invariance-v1
BENCHMARK_HARNESS_REPO_ROOT=.
BENCHMARK_SCORE_SCRIPT_PATH=benchmarks/suites/repository-intelligence/context-invariance-v1/score.py
BENCHMARK_SCORE_OUTPUT_PATH=score.json
