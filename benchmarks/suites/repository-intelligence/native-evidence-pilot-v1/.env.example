# Copy to a private environment file. Set the clean, committed subject checkout.
HASHMARKS_BENCH_SOURCE=/absolute/path/to/Hashmarks

# These are two experiment configurations of the same installed native Codex.
BENCHMARK_AGENT=codex-native,codex-required
BENCHMARK_PASSTHROUGH_ENV_KEYS=

BENCHMARK_SUITE_PATH=benchmarks/suites/repository-intelligence/native-evidence-pilot-v1
BENCHMARK_CAMPAIGN_ROOT=.benchmark-runs/native-evidence-pilot-v1
BENCHMARK_HARNESS_REPO_ROOT=.
BENCHMARK_SCORE_SCRIPT_PATH=benchmarks/suites/repository-intelligence/native-evidence-pilot-v1/score.py
BENCHMARK_SCORE_OUTPUT_PATH=score.json
